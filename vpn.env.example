# Configuration du VPN (gluetun) : copier en vpn.env et remplir.
# vpn.env est ignoré par git.
# Doc par fournisseur : https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers

# --- CyberGhost (OpenVPN) ---
# 1. https://my.cyberghostvpn.com → VPN → Configure device → Other → OpenVPN,
#    choisir un pays qui autorise le torrent, Protocol UDP, puis télécharger le zip.
# 2. Copier client.crt et client.key du zip dans config/gluetun/
# 3. Recopier ci-dessous l'utilisateur et le mot de passe affichés sur cette page
#    (ce ne sont PAS les identifiants de ton compte CyberGhost).
VPN_SERVICE_PROVIDER=cyberghost
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_COUNTRIES=Switzerland
# CyberGhost n'ouvre pas de port : le téléchargement marche, le seed est plus limité
VPN_PORT_FORWARDING=off

# --- ProtonVPN Plus (alternative, WireGuard + port forwarding) ---
# VPN_SERVICE_PROVIDER=protonvpn
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# SERVER_COUNTRIES=Switzerland
# PORT_FORWARD_ONLY=on
# VPN_PORT_FORWARDING=on
