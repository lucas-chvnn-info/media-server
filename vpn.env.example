# Configuration du VPN (gluetun) — copier en vpn.env et remplir.
# vpn.env est ignoré par git.
# Doc complète par fournisseur : https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers

# --- ProtonVPN (offre Plus : P2P + port forwarding) ---
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
# Compte Proton → Downloads → WireGuard configuration → « PrivateKey » du fichier .conf
# (cocher « NAT-PMP (Port Forwarding) » à la création)
WIREGUARD_PRIVATE_KEY=
SERVER_COUNTRIES=Switzerland
PORT_FORWARD_ONLY=on
VPN_PORT_FORWARDING=on

# --- AirVPN (alternative) ---
# VPN_SERVICE_PROVIDER=airvpn
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_PRESHARED_KEY=
# WIREGUARD_ADDRESSES=
# SERVER_COUNTRIES=Switzerland
# FIREWALL_VPN_INPUT_PORTS=   # port ouvert dans le Client Area AirVPN
